--// ---------------- Wallcheck ----------------
local function clearPath(part, from)
    if not S.wall then return true end
    if not part or not part.Parent or not from then return true end

    local cam = workspace.CurrentCamera
    local goal = part.Position
    local dir  = goal - from
    local dist = dir.Magnitude
    if dist < 1 then return true end

    local rootOfPart = part
    while rootOfPart.Parent and rootOfPart.Parent ~= workspace do
        rootOfPart = rootOfPart.Parent
    end

    local ignore = { part }
    if LP_CHAR then ignore[#ignore + 1] = LP_CHAR end
    if cam then ignore[#ignore + 1] = cam end
    if rootOfPart ~= part then ignore[#ignore + 1] = rootOfPart end
    rayParams.FilterDescendantsInstances = ignore

    local o = from
    for _ = 1, 5 do
        local res = workspace:Raycast(o, dir.Unit * (dist + 0.5), rayParams)
        if not res then return true end
        local hit = res.Instance
        if hit == part or hit:IsDescendantOf(part) or hit:IsDescendantOf(rootOfPart) then
            return true
        end
        if hit.Transparency >= 0.85 then
            o = res.Position + dir.Unit * 0.6
            dist = (goal - o).Magnitude
            if dist <= 1 then return true end
        else
            return false
        end
    end
    return true
end

--// ---------------- Glow ----------------
local function nearGlow(c)
    local tol = S.tol / 255
    return math.abs(c.R - GLOW_COLOR.R) <= tol
        and math.abs(c.G - GLOW_COLOR.G) <= tol
        and math.abs(c.B - GLOW_COLOR.B) <= tol
end

local function isGlow(part)
    if not part.Name:lower():find(GLOW_NAME:lower(), 1, true) then return false end
    if nearGlow(part.Color) then return true end
    for _, d in ipairs(part:GetDescendants()) do
        if d:IsA("BasePart") and nearGlow(d.Color) then return true end
    end
    return false
end

local function isGone(part)
    if not part or not part.Parent then return true end
    if part.Transparency >= 1 then return true end
    for _, a in ipairs(part:GetAttributes()) do
        local n = a:lower()
        local v = part:GetAttribute(a)
        if type(v) == "boolean" and v and (n:find("min") or n:find("break") or n:find("empty") or n:find("done")) then
            return true
        end
        if type(v) == "number" and v <= 0 and (n:find("health") or n:find("hp") or n:find("dura")) then
            return true
        end
    end
    return false
end

--// ---------------- Escaneo ----------------
local function scan()
    local pl, gl = {}, {}
    local o = origin()
    if not o then
        prompts, glows = pl, gl
        return
    end

    local floorY = LP_ROOT.Position.Y
    local lowest = o.Y - Y_MARGIN
    if S.downScan then
        lowest = floorY - DOWN_DEPTH
    end

    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            local p = d.Parent
            if p and p:IsA("BasePart") and p.Parent and d.Enabled then
                d.HoldDuration = 0
                local dist = (p.Position - o).Magnitude
                if dist <= RANGE then
                    pl[#pl + 1] = { prompt = d, part = p, dist = dist }
                end
            end
        elseif d:IsA("BasePart") then
            if isGlow(d) and not isGone(d) and not mined[d] then
                local dist = (d.Position - o).Magnitude
                if dist <= RANGE and d.Position.Y >= lowest then
                    gl[#gl + 1] = { part = d, dist = dist }
                end
            end
        end
    end

    table.sort(pl, function(a, b) return a.dist < b.dist end)
    table.sort(gl, function(a, b) return a.dist < b.dist end)
    prompts, glows = pl, gl
end

local function nextPrompt()
    local o = origin()
    if not o then return nil end
    for _, p in ipairs(prompts) do
        if p.part.Parent and p.prompt.Enabled and p.dist <= S.maxTravel
            and (promptCD[p.prompt] or 0) < os.clock() and clearPath(p.part, o) then
            return p
        end
    end
    return nil
end

local function nextGlow()
    local o = origin()
    if not o then return nil end
    local best, bestD = nil, math.huge
    for _, g in ipairs(glows) do
        local p = g.part
        if p.Parent and not mined[p] and not isGone(p) then
            local dist = (p.Position - o).Magnitude
            if dist < bestD and clearPath(p, o) then
                best, bestD = p, dist
            end
        end
    end
    return best
end

--// ---------------- Movimiento ----------------
local function jitter()
    local jx, jy = S.offX, S.offY
    return Vector3.new(
        (math.random() * 2 - 1) * jx,
        (math.random() * 2 - 1) * jy,
        (math.random() * 2 - 1) * jx
    )
end

local function step(pos)
    if not alive() then return end
    local aim = pos + jitter()
    if S.tpwalk then
        local dir = aim - LP_ROOT.Position
        local flat = Vector3.new(dir.X, 0, dir.Z)
        if flat.Magnitude > 0.1 then
            LP_ROOT.CFrame = CFrame.lookAt(LP_ROOT.Position, LP_ROOT.Position + flat.Unit)
        end
        LP_ROOT.AssemblyLinearVelocity = dir.Unit * 120
    else
        LP_ROOT.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        LP_ROOT.CFrame = CFrame.new(aim)
    end
end

local function firePrompt(prompt)
    if not prompt or not prompt.Enabled then return false end
    if typeof(fireproximityprompt) == "function" then
        pcall(fireproximityprompt, prompt)
        return true
    end
    pcall(function()
        prompt:InputHoldBegin()
        task.delay(0.05, function()
            pcall(function() prompt:InputHoldEnd() end)
        end)
    end)
    return true
end

local function virtualClick(x, y)
    pcall(function() VirtualInputManager:SendMouseMoveEvent(x, y, game) end)
    task.wait(0.02)
    if typeof(mouse1press) == "function" and typeof(mouse1release) == "function" then
        pcall(mouse1press)
        task.wait(0.06)
        pcall(mouse1release)
        return
    end
    pcall(function() VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1) end)
    task.wait(0.06)
    pcall(function() VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1) end)
end

local function mineClick(part)
    local prompt = part:FindFirstChildWhichIsA("ProximityPrompt", true)
    if prompt and prompt.Enabled then
        prompt.HoldDuration = 0
        firePrompt(prompt)
    end

    local cd = part:FindFirstChildWhichIsA("ClickDetector", true)
    if cd then
        if typeof(fireclickdetector) == "function" then
            pcall(fireclickdetector, cd)
        else
            pcall(function() cd:FireClick() end)
        end
    end

    local tool = LP_CHAR and LP_CHAR:FindFirstChildOfClass("Tool")
    if tool then pcall(function() tool:Activate() end) end

    local cam = workspace.CurrentCamera
    if cam then
        local sp, on = cam:WorldToScreenPoint(part.Position)
        if on then virtualClick(sp.X, sp.Y) end
    end
end

