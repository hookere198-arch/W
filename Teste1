--// ---------------- Config ----------------
local saveQ = false

local function saveCfg()
    if not (writefile and HttpService) then return end
    local d = {}
    for k, v in pairs(S) do
        if typeof(v) == "EnumItem" then
            d[k] = "E:" .. tostring(v)
        else
            d[k] = v
        end
    end
    pcall(writefile, CFG_FILE, HttpService:JSONEncode(d))
end

local function queueSave()
    if saveQ then return end
    saveQ = true
    task.delay(0.4, function()
        saveQ = false
        saveCfg()
    end)
end

local function loadCfg()
    if not (readfile and isfile and HttpService) then return end
    local ok, raw = pcall(function()
        if isfile(CFG_FILE) then return readfile(CFG_FILE) end
    end)
    if not ok or type(raw) ~= "string" or raw == "" then return end
    local ok2, d = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok2 or type(d) ~= "table" then return end
    for k, v in pairs(d) do
        if S[k] ~= nil then
            if type(v) == "string" and v:sub(1, 2) == "E:" then
                local item = Enum.KeyCode[v:sub(3)]
                if item then S[k] = item end
            elseif type(v) == type(S[k]) then
                S[k] = v
            end
        end
    end
end

