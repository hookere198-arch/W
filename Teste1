local function makeSlider(label, key, min, max, stepSize, order, fmt, onEnd)
    local f = row(order, 38)
    local lbl = new("TextLabel", {
        Text = label .. ": " .. fmt(S[key]), Font = Enum.Font.Gotham, TextSize = 11,
        TextColor3 = Color3.fromRGB(215, 215, 225), TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1, Position = UDim2.fromOffset(8, 4),
        Size = UDim2.new(1, -16, 0, 14), ZIndex = 13,
    }, f)

    local bar = new("Frame", {
        Position = UDim2.fromOffset(8, 25), Size = UDim2.new(1, -16, 0, 4),
        BackgroundColor3 = DIMC, BorderSizePixel = 0, ZIndex = 13,
    }, f)
    new("UICorner", { CornerRadius = UDim.new(1, 0) }, bar)

    local fill = new("Frame", {
        Size = UDim2.fromScale((S[key] - min) / (max - min), 1),
        BackgroundColor3 = ACCENT, BorderSizePixel = 0, ZIndex = 14,
    }, bar)
    new("UICorner", { CornerRadius = UDim.new(1, 0) }, fill)

    local held = false

    local function apply(mx)
        local ratio = math.clamp((mx - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
        local val = min + ratio * (max - min)
        val = math.floor(val / stepSize + 0.5) * stepSize
        S[key] = val
        fill.Size = UDim2.fromScale(ratio, 1)
        lbl.Text = label .. ": " .. fmt(val)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            held = true
            apply(input.Position.X)
        end
    end)
    track(UserInputService.InputChanged:Connect(function(input)
        if held and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            apply(input.Position.X)
        end
    end))
    track(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if held then
                queueSave()
                if onEnd then onEnd() end
            end
            held = false
        end
    end))
end

