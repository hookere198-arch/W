local function checkHealth()
    if not alive() then return end
    local ratio = LP_HUM.Health / math.max(LP_HUM.MaxHealth, 1)
    if not S.escape then
        escaped = false
        return
    end
    if ratio <= 0.5 and not escaped then
        escaped = true
        LP_ROOT.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        LP_ROOT.CFrame = CFrame.new(LP_ROOT.Position + Vector3.new(0, 5000, 0))
    elseif ratio > 0.5 then
        escaped = false
    end
end

